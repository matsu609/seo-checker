# ─────────────────────────────────────────────────────────────
# SEO Checker の環境変数（docs/dev/ARCHITECTURE.md「外部連携」）
# すべて任意。未設定の連携は画面に「未設定」と出て、その機能だけ使えなくなります。
# この内容を .env.local にコピーして値を入れ、開発サーバーを再起動してください。
# キーはサーバーだけが読み、ブラウザには渡りません。
# ─────────────────────────────────────────────────────────────

# ── Clerk（ログイン）──────────────────────────────────────────
# 両方そろったときだけログインが有効になります。
# 未設定のままだと認証は無効で、ツール画面と API が誰でも使える状態になります
# （開発と E2E では正常。本番に出す前に必ず設定してください）。
#
# 取得先: Clerk ダッシュボード → API Keys
# 公開範囲: 無料診断（/ と /api/analyze・/api/site・/api/faq）は未ログインでも使えます。
#           それ以外のツール画面と API はログインが必要です。
# 注意: 誰でも登録できないよう、Clerk 側の Restrictions で招待制か
#       許可リストにしておいてください（既定は誰でも登録できます）。
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ログイン後の遷移先などを変えたいときだけ（既定はアプリ側で指定済み）
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ── 料金プラン ────────────────────────────────────────────────
# 3 段階（free / standard / pro）。プランの決まり方は次の順です。
#   1. ログインが未設定のとき … すべて pro 扱い（開発・検証用）
#   2. Clerk Billing の契約プラン（決済を有効にした場合）
#   3. Clerk の publicMetadata.plan … 運用者がダッシュボードで割り当てる
#   4. この DEFAULT_PLAN
#   5. どれも無ければ free（無料診断のみ）
#
# 決済を入れる前に全員へ一律で開放したいときだけ設定してください。
# 値は free / standard / pro のいずれか。
# DEFAULT_PLAN=

# ── 決済（Clerk Billing / Stripe）──────────────────────────────
# 有料プランをカード決済で売るときだけ設定します。決済の実体は Stripe ですが、
# 契約状態は Clerk が持つため、このアプリはやはりデータベースを持ちません。
#
# 準備（1 回だけ）:
#   1. Clerk ダッシュボード → 「請求する」(Billing) を開き、Stripe アカウントを接続する
#      （Stripe アカウントが無ければその場で作成できます）
#   2. プランを 2 つ作る。スラッグ（slug）は必ず standard と pro にすること。
#      ここがずれると「決済は通ったのに機能が開かない」状態になります。
#        standard … 月額 5,000 円
#        pro      … 月額 10,000 円
#   3. この変数を 1 にして再起動（Vercel なら環境変数に追加して Redeploy）
#
# 1 のときだけ、/plans に Clerk の料金表（購入・変更・解約）が出ます。
# 未設定なら料金表は出ず、プラン変更は運用者への連絡になります。
# 契約したプランは Clerk Billing → publicMetadata.plan → DEFAULT_PLAN の順で見ます。
#
# 費用の注意: Clerk Billing を使うと、Stripe の決済手数料に加えて Clerk 側の
# 手数料がかかります。料率と必要な Clerk のプランは変わることがあるので、
# Clerk ダッシュボードの「請求する」画面で最新を確認してください。手数料を
# 抑えたい場合は Clerk Billing を使わず（この変数を空のまま）、Stripe を
# 直接組み込む形にもできます。
# NEXT_PUBLIC_CLERK_BILLING_ENABLED=1

# ── マスター画面（運用者向け）────────────────────────────────
# ここに書いたメールアドレスの人だけが /admin を開けます。
# 顧客ごとの契約状況・月額・クーポンが見える画面なので、必ず絞ってください。
#
# 未設定なら誰も入れません（既定は閉じています）。区切りはカンマ・空白・改行。
# 判定は Clerk 側で「確認済み」のメールアドレスに対してのみ行います。
# ADMIN_EMAILS=you@example.com

# ── Google 連携（Search Console / GA4）──────────────────────────
# ここに書く環境変数はありません。利用者が設定画面から自分の Google
# アカウントを接続し、見る対象のサイト / プロパティを選びます。
# トークンは Clerk が保持し、選択内容は Clerk の privateMetadata に入るため、
# このアプリはデータベースを持ちません。
#
# 使えるようにするための準備（1 回だけ）:
#   1. Google Cloud のプロジェクトで OAuth 2.0 クライアント ID（ウェブ）を作る
#   2. そのプロジェクトで Search Console API と Google Analytics Admin API、
#      Google Analytics Data API を有効にする
#   3. Clerk ダッシュボード → SSO Connections → Google を「独自のクレデンシャル」
#      に切り替え、1 のクライアント ID とシークレットを入れる
#   4. Google 側の「承認済みのリダイレクト URI」に Clerk が表示する URI を追加する
#
# 読み取りスコープ（webmasters.readonly / analytics.readonly）はアプリが接続時に
# 要求するので、Clerk 側でスコープを足す必要はありません。

# ── Anthropic（Claude）────────────────────────────────────────
# FAQ 生成（無料診断）、LLM サマリー、LLMO（Claude）、プロンプト拡張、AI ライティングで使用
ANTHROPIC_API_KEY=

# 分析・生成に使うモデル（既定: claude-opus-5）
# LLM_MODEL=claude-opus-5

# 分類・判定など大量処理に使うモデル（既定: claude-haiku-4-5）
# LLM_FAST_MODEL=claude-haiku-4-5

# FAQ 生成に使うモデル（既定: claude-haiku-4-5）
# FAQ_MODEL=claude-haiku-4-5

# ── 他社 LLM（LLMO モニタリングで対象に加える）─────────────────
# OpenAI（ChatGPT）
# OPENAI_API_KEY=
# Google Gemini
# GEMINI_API_KEY=
# Perplexity
# PERPLEXITY_API_KEY=

# ── SerpApi（Google 検索結果）────────────────────────────────
# 順位計測・AI Overviews の引用チェック・ページ診断の上位 10 件取得
# SERPAPI_KEY=

# ── PageSpeed Insights ────────────────────────────────────────
# 表示速度・Core Web Vitals。無くても低頻度なら動きますが、キーがあると上限が緩みます
# PAGESPEED_API_KEY=

# ── Google マップ（Places API (New)）──────────────────────────
# Google マップ・店舗情報（MEO）。自社と競合のビジネス プロフィールの比較と採点。
# Google Cloud で「Places API (New)」を有効化し、この API だけに制限した API キーを作る。
# 請求先アカウントの登録が必要（月ごとの無料枠あり。予算アラートの設定を推奨）
# GOOGLE_PLACES_API_KEY=

# ── Google Analytics 4（GA4 Data API）────────────────────────
# 生成 AI 流入分析・サイトレポート。両方必要です
# GA4 のプロパティ ID（数字のみ。例: 123456789）
# GA4_PROPERTY_ID=
# サービスアカウントの JSON をそのまま 1 行で、または base64 にしたもの
# （サービスアカウントを GA4 プロパティの「閲覧者」に追加しておく）
# GOOGLE_SERVICE_ACCOUNT_JSON=

# ── クロール ───────────────────────────────────────────────────
# 無料診断「サイト全体」・サイト診断で取得するページ数の上限（既定 300、上限 1000）
# SITE_MAX_PAGES=300

# ── 表示 ───────────────────────────────────────────────────────
# サイドバー下に出すバージョン表記（省略時は package.json の version）
# NEXT_PUBLIC_APP_VERSION=

# 無料診断レポート末尾の「次のステップ」に出す連絡先（両方無ければブロックごと非表示）
# NEXT_PUBLIC_CONTACT_NAME=
# NEXT_PUBLIC_CONTACT_URL=

# サービス資料の配布ファイル。
# 未設定なら、機能一覧と料金プランから資料をその場で組み立てて PDF にします
# （内容が自動で最新に保たれます）。
# デザイン済みの資料をお持ちの場合は public/ に置いてパスを入れてください。
# 例: NEXT_PUBLIC_SERVICE_GUIDE_URL=/service-guide.pdf
# NEXT_PUBLIC_SERVICE_GUIDE_URL=

# ── 開発用 ─────────────────────────────────────────────────────
# localhost や LAN 内のサイトを診断したいときだけ 1 にする（本番では絶対に設定しない）
# ALLOW_PRIVATE_HOSTS=1

# ── Supabase（診断履歴の保存）────────────────────────────────
# MEO 診断報告書の「保存」と履歴に使う。未設定なら保存ボタンと履歴を出さない。
# Supabase のプロジェクト設定 → API Keys から。URL は https://xxxx.supabase.co（/rest/v1/ 付きでも可）。
# キーは従来の service_role（JWT）でも新しい Secret key（sb_secret_...）でもよい
# （サーバー専用。NEXT_PUBLIC_ を付けない）。テーブルは docs/dev/OPERATIONS.md の SQL で作る。
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# ── 無料 MEO 診断（/meo、ログイン不要）の上限 ─────────────────
# Google Places に実費が出るため、1 日の全体上限を置く（既定: 報告書 500 / 検索 1,500）。
# 0 にすると無料 MEO 診断を止められる。IP ごとの制限（報告書 10 回 / 時、検索 30 回 / 時）はコード側。
# FREE_MEO_DAILY_LIMIT=500
# FREE_MEO_DAILY_SEARCH_LIMIT=1500

# ── 一斉更新（Vercel Cron）──────────────────────────────────
# Google マップ・店舗情報の数字は毎週月曜 5:00（日本時間）に一斉更新する（vercel.json）。
# Vercel は Cron の呼び出しに Authorization: Bearer <CRON_SECRET> を付ける。
# 未設定なら /api/cron/maps-refresh は何もしない。長いランダムな文字列にする。
# CRON_SECRET=
