# 無料診断（切り出し版）の環境変数
#
# 使い方: このファイルを .env.local にコピーして、使いたい機能の値を入れる。
#   cp .env.example .env.local
#
# 無料 SEO・AIO 診断（/）は、キーが 1 つも無くても動きます。
# 無料 MEO 診断（/meo）だけは Google Places のキーが要ります。
# キーはすべてサーバー側でのみ読み、ブラウザには渡しません（NEXT_PUBLIC_ の付いたものを除く）。

# ── Google マップ（Places API (New)）──────────────────────────
# 無料 MEO 診断（/meo）に必須。未設定なら画面は「準備中」を出します。
# Google Cloud で「Places API (New)」を有効化し、この API だけに制限したキーを作る。
# 請求先アカウントの登録が必要（呼び出しごとに実費。予算アラートの設定を推奨）
# GOOGLE_PLACES_API_KEY=

# ── 無料 MEO 診断の上限 ───────────────────────────────────────
# 実費が出るので 1 日の全体上限を置く（既定: 報告書 500 / 検索 1,500）。
# 0 にすると無料 MEO 診断を止められる。
# IP ごとの制限（報告書 10 回 / 時、検索 30 回 / 時）はコード側（src/lib/free/ratelimit.ts）。
# FREE_MEO_DAILY_LIMIT=500
# FREE_MEO_DAILY_SEARCH_LIMIT=1500

# ── Anthropic（Claude）────────────────────────────────────────
# 無料 SEO・AIO 診断の「想定 FAQ の生成」だけに使う。未設定ならその欄を出しません。
# ANTHROPIC_API_KEY=

# FAQ 生成に使うモデル（既定: claude-haiku-4-5）
# FAQ_MODEL=claude-haiku-4-5

# ── クロール ───────────────────────────────────────────────────
# 「サイト全体」で取得するページ数の上限（既定 300、上限 1000）
# SITE_MAX_PAGES=300

# ── 表示 ───────────────────────────────────────────────────────
# サイドバー下のバージョン表記（省略時は package.json の version）
# NEXT_PUBLIC_APP_VERSION=

# レポート末尾の「次のステップ」に出す連絡先（両方無ければブロックごと非表示）
# NEXT_PUBLIC_CONTACT_NAME=
# NEXT_PUBLIC_CONTACT_URL=

# サービス資料の配布ファイル。未設定なら、機能一覧と料金プランから資料を
# その場で組み立てて PDF にします。public/ に置いたファイルを配る場合はパスを入れる。
# NEXT_PUBLIC_SERVICE_GUIDE_URL=

# 有料プラン・新規登録の案内リンクの送り先（既定: https://app.seo-checker.tokyo）。
# この切り出し版には有料機能もログインも無いので、本体サービスへ送ります。
# NEXT_PUBLIC_MAIN_APP_URL=https://app.seo-checker.tokyo

# ── 開発用 ─────────────────────────────────────────────────────
# localhost や LAN 内のサイトを診断したいときだけ 1 にする（本番では絶対に設定しない）
# ALLOW_PRIVATE_HOSTS=1
